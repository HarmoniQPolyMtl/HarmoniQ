DB_USER=postgres
DB_PASSWORD=harmoniq
DB_HOST=localhost
DB_PORT=5432
DB_NAME=harmoniq

DATABASE_URL=postgresql://postgres:harmoniq@localhost:5432/harmoniq

# PostgreSQL Superuser
# Only needed when the harmoniq user/database don't yet exist.
# If doing a fresh PostgreSQL install, init-db uses these to create the user.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERPASSWORD=harmoniq
